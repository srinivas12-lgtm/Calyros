# ==========================================
# CALYROS BACKEND ENVIRONMENT VARIABLES
# ==========================================

# PostgreSQL Database URL (Neon / Supabase Postgres / Render Postgres)
DATABASE_URL=postgresql://user:password@host/dbname

# App & Environment
ENVIRONMENT=production
APP_PORT=8000
DEBUG=false
BACKEND_CORS_ORIGINS=https://your-frontend-app.onrender.com,http://localhost:5173

# JWT Auth & Security (Generate using: openssl rand -hex 32)
JWT_SECRET_KEY=your_32_char_hex_secret_key_here
REFRESH_SECRET_KEY=your_32_char_hex_refresh_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Models & APIs (Required)
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=your_groq_api_key_here
GROQ_REASONING_MODEL=openai/gpt-oss-20b

# Redis (Upstash / Redis)
REDIS_URL=rediss://default:your_password@your_endpoint:6379

# Supabase Storage (Scans bucket for food images)
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# Error Tracking (Optional)
SENTRY_DSN=

# ==========================================
# CALYROS FRONTEND ENVIRONMENT VARIABLES (Vite)
# ==========================================
VITE_API_URL=https://your-backend-service.onrender.com/api/v1
VITE_SUPABASE_URL=https://your_project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key
